// Sección Programas: lista con búsqueda y orden, y los avisos de la desinstalación.
// Todo llega por `ProgramsData`.
import { Palette, Type, Icon } from "../theme.slint";
import { Button, ButtonKind, Note, Seg, SearchBox, Spinner, AppIcon, EmptyState, Tone } from "../widgets.slint";
import { Head, ListBox } from "clean.slint";

export struct ProgramRow {
    name: string,
    publisher: string,
    // «03/02/2025» o «—».
    date: string,
    // «412 MB» o «—».
    size: string,
    // El icono real; si no hay (ancho 0), la baldosa con `letter` sobre `tint`.
    icon: image,
    letter: string,
    tint: color,
    // Entrada de HKLM sin ser administrador: «Desinstalar» lleva el escudo.
    needs-admin: bool,
    // De HKCU siendo administrador: no se lanza (lo explica el aviso 4).
    blocked: bool,
}

export global ProgramsData {
    // «86 instalados · 38,2 GB»
    in property <string> subtitle;
    in property <bool> loading: true;
    in-out property <string> query;
    // 0 tamaño, 1 nombre, 2 fecha.
    in-out property <int> sort;
    in property <[ProgramRow]> rows;
    in-out property <int> selected: -1;
    // 0 lista, 1 esperando al desinstalador.
    in property <int> phase;
    // 0 nada, 1 hecho, 2 error, 3 sigue instalado, 4 de HKCU siendo administrador.
    in property <int> banner;
    in property <string> banner-title;
    in property <string> banner-text;
    // Con el aviso 2, la carpeta que abre «Abrir carpeta».
    in property <string> banner-path;
    callback uninstall(int);
    callback done-waiting();
    callback dismiss();
    callback open-folder();
    // La búsqueda o el orden han cambiado (ya escritos en `query` y `sort`): Rust rehace `rows`.
    callback view-changed();
}

component HeadText inherits Text {
    color: Palette.fa;
    font-size: 11.5px;
    letter-spacing: 0.6px;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// Columnas de la lista: icono, nombre, fecha (no en estrecho), tamaño y acción.
component Columns inherits HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;
    spacing: 14px;
}

component ProgramItem {
    in property <ProgramRow> item;
    in property <bool> selected;
    in property <bool> compact;
    // Mientras se espera al desinstalador, la lista no se toca.
    in property <bool> locked;
    callback select();
    callback uninstall();
    height: 61px;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.size;
    accessible-action-default => {
        if (!root.locked) { root.select(); }
    }

    Rectangle {
        background: root.selected ? Palette.s2 : touch.has-hover ? Palette.s2.with-alpha(0.5) : transparent;
    }
    Rectangle {
        y: 0;
        height: 1px;
        background: Palette.line;
    }
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        background: Palette.ac;
    }

    touch := TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }

    Columns {
        VerticalLayout {
            alignment: center;
            AppIcon {
                img: root.item.icon;
                letter: root.item.letter;
                tint: root.item.tint;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.item.name;
                color: Palette.tx;
                font-weight: 500;
                overflow: elide;
            }
            Text {
                text: root.item.publisher;
                color: Palette.fa;
                font-size: Type.label;
                overflow: elide;
            }
        }
        if !root.compact: Text {
            width: 110px;
            text: root.item.date;
            color: Palette.fa;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 90px;
            text: root.item.size;
            color: Palette.tx;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        HorizontalLayout {
            width: 130px;
            alignment: end;

            if root.selected: VerticalLayout {
                alignment: center;
                Button {
                    text: "Desinstalar";
                    icon: root.item.needs-admin ? "shield" : "";
                    clicked => { root.uninstall(); }
                }
            }
        }
    }
}

export component ProgramsPage inherits Rectangle {
    in property <bool> compact;
    property <bool> waiting: ProgramsData.phase == 1;

    VerticalLayout {
        padding-top: root.compact ? 20px : 28px;
        padding-bottom: root.compact ? 20px : 28px;
        padding-left: root.compact ? 20px : 32px;
        padding-right: root.compact ? 20px : 32px;
        spacing: 18px;
        // Arriba del todo; la lista y el estado vacío piden más de lo que cabe y se encogen
        // hasta llenar lo que queda (la lista, solo hasta su contenido).
        alignment: start;

        Head {
            vertical-stretch: 0;
            title: "Programas";
            text: ProgramsData.subtitle;
        }

        if root.waiting: Rectangle {
            vertical-stretch: 0;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.line2;
            background: Palette.s1;

            HorizontalLayout {
                padding: 12px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;

                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Spinner { }
                }
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: ProgramsData.banner-title;
                        color: Palette.tx;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: ProgramsData.banner-text;
                        color: Palette.mu;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Ya he terminado";
                        clicked => { ProgramsData.done-waiting(); }
                    }
                }
            }
        }

        if !root.waiting && ProgramsData.banner != 0: Note {
            vertical-stretch: 0;
            kind: ProgramsData.banner == 1 ? Tone.ok : ProgramsData.banner == 2 ? Tone.bad
                : ProgramsData.banner == 3 ? Tone.warn : Tone.info;
            icon: ProgramsData.banner == 1 ? "check" : ProgramsData.banner == 4 ? "info" : "warn";
            title: ProgramsData.banner-title;
            text: ProgramsData.banner-text;

            if ProgramsData.banner == 2 && ProgramsData.banner-path != "": Button {
                text: root.compact ? "" : "Abrir carpeta";
                icon: "folder";
                accessible-label: "Abrir carpeta";
                clicked => { ProgramsData.open-folder(); }
            }
            Button {
                text: "";
                icon: "x";
                accessible-label: "Cerrar aviso";
                clicked => { ProgramsData.dismiss(); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            SearchBox {
                width: root.compact ? 180px : 260px;
                placeholder: "Buscar programa…";
                text <=> ProgramsData.query;
                edited => {
                    ProgramsData.selected = -1;
                    ProgramsData.view-changed();
                }
            }
            Seg {
                items: ["Tamaño", "Nombre", "Fecha"];
                current <=> ProgramsData.sort;
                selected => {
                    ProgramsData.selected = -1;
                    ProgramsData.view-changed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // Crece hasta su contenido y, si no cabe, se desplaza por dentro.
        if ProgramsData.rows.length > 0: ListBox {
            preferred-height: 39px + ProgramsData.rows.length * 61px;
            min-height: 100px;
            opacity: root.waiting ? 0.4 : 1;

            Rectangle {
                height: 39px;
                background: Palette.bg;

                Columns {
                    Rectangle { width: 30px; }
                    HeadText {
                        text: "NOMBRE";
                        horizontal-stretch: 1;
                        horizontal-alignment: left;
                    }
                    if !root.compact: HeadText {
                        width: 110px;
                        text: "INSTALADO";
                    }
                    HeadText {
                        width: 90px;
                        text: "TAMAÑO";
                    }
                    Rectangle { width: 130px; }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    width: parent.width;
                    for row[i] in ProgramsData.rows: ProgramItem {
                        item: row;
                        compact: root.compact;
                        locked: root.waiting;
                        selected: ProgramsData.selected == i;
                        select => { ProgramsData.selected = i; }
                        uninstall => { ProgramsData.uninstall(i); }
                    }
                }
            }
        }

        if ProgramsData.rows.length == 0: EmptyState {
            preferred-height: 100000px;
            min-height: 160px;
            icon: ProgramsData.query != "" ? "search" : "apps";
            title: ProgramsData.query != "" ? "Ningún programa coincide con «" + ProgramsData.query + "»"
                : ProgramsData.loading ? "Leyendo los programas instalados…" : "No hay programas que mostrar";
            text: ProgramsData.query != "" ? "Revisa cómo está escrito. Las apps de Microsoft Store no salen en esta lista."
                : ProgramsData.loading ? "" : "Las apps de Microsoft Store no salen en esta lista.";
        }
    }
}
